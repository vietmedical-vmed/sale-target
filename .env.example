# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env lên git.
# Lấy key ở Supabase Dashboard → Project Settings → API Keys.
#
# SERVICE_ROLE_KEY bỏ qua toàn bộ RLS → chỉ dùng cho script chạy phía máy chủ
# hoặc máy cá nhân. TUYỆT ĐỐI không nhúng vào index.html hay bất kỳ file nào
# chạy trên trình duyệt (trang web chỉ được dùng anon / publishable key).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
